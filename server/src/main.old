use embedded_graphics::pixelcolor::raw::RawU16;
use embedded_graphics::primitives::Rectangle;
use gif::DecodeOptions;
use linux_embedded_hal::SpidevDevice;
use mipidsi::TestImage;
use mipidsi::interface::SpiInterface;
use mipidsi::models::{GC9A01, ST7789};
// Provides the builder for DisplayInterface
use embedded_graphics::{pixelcolor::Rgb565, prelude::*};
use mipidsi::options::Orientation;
use mipidsi::{Builder, models::ILI9486Rgb666}; // Provides the builder for Display
use rppal::gpio::{self, Gpio};
use rppal::hal::Delay;
use rppal::spi::{Bus, Spi};
use spidev::{SpiModeFlags, Spidev, SpidevOptions}; // Provides the required color type
use std::error::Error;
use std::io::Cursor;
use tinybmp::Bmp;

mod constants;
mod display;
mod raw;

fn create_spi() -> std::io::Result<Spidev> {
    let mut spi = Spidev::open("/dev/spidev0.0")?;
    let options = SpidevOptions::new()
        .bits_per_word(8)
        .max_speed_hz(60_000_000)
        .mode(SpiModeFlags::SPI_MODE_0)
        .build();
    spi.configure(&options)?;
    Ok(spi)
}
fn create_spi2() -> std::io::Result<Spidev> {
    let mut spi = Spidev::open("/dev/spidev3.0")?;
    let options = SpidevOptions::new()
        .bits_per_word(8)
        .max_speed_hz(16_000_000)
        .mode(SpiModeFlags::SPI_MODE_0)
        .build();
    spi.configure(&options)?;
    Ok(spi)
}

fn main() -> Result<(), Box<dyn Error>> {
    let gpio = Gpio::new()?;
    let mut delay = Delay::new();
    let mut delay2 = Delay::new();

    /* Define the SPI interface as the variable `spi` */
    // let spi = Spi::new(Bus::Spi0, rppal::spi::SlaveSelect::Ss0, 40_000_000, rppal::spi::Mode::Mode0).unwrap();
    let spidev = create_spi().unwrap();
    let spidev2 = create_spi2().unwrap();
    let spi = SpidevDevice(spidev);
    let spi2 = SpidevDevice(spidev2);
    /* Define the DC digital output pin as the variable `dc` */
    let dc = gpio.get(24)?.into_output();
    let dc2 = gpio.get(21)?.into_output();
    /* Define the Reset digital output pin as the variable `rst` */
    let rst = gpio.get(25)?.into_output();
    let rst2 = gpio.get(16)?.into_output();

    // Create a buffer
    let mut buffer = [0_u8; 1024];
    let mut buffer2 = [0_u8; 1024];

    // Create a DisplayInterface from SPI and DC pin, with no manual CS control
    let di = SpiInterface::new(spi, dc, &mut buffer);
    let di2 = SpiInterface::new(spi2, dc2, &mut buffer2);

    // Create the ILI9486 display driver from the display interface and optional RST pin
    let mut display: mipidsi::Display<
        SpiInterface<'_, SpidevDevice, gpio::OutputPin>,
        GC9A01,
        gpio::OutputPin,
    > = Builder::new(GC9A01, di)
        .reset_pin(rst)
        .invert_colors(mipidsi::options::ColorInversion::Inverted)
        .color_order(mipidsi::options::ColorOrder::Bgr)
        //.display_size(240, 320)
        //.display_offset(0, 20)
        .init(&mut delay)
        .unwrap();

    let mut display2 = Builder::new(GC9A01, di2)
        .reset_pin(rst2)
        .invert_colors(mipidsi::options::ColorInversion::Inverted)
        .init(&mut delay2)
        .unwrap();

    // Clear the display to black
    display.clear(Rgb565::BLUE).unwrap();
    TestImage::new().draw(&mut display).unwrap();
    TestImage::new().draw(&mut display2).unwrap();
    const BMP_DATA: &[u8] = include_bytes!("../meow.bmp");

    // 2. Parse the BMP data into Rgb565 pixels
    let bmp: Bmp<Rgb565> = Bmp::from_slice(BMP_DATA).expect("Failed to parse BMP image");

    // 3. Option A: Draw image at top-left corner (0, 0)
    bmp.draw(&mut display).expect("Failed to draw image");
    play_gif_file(&mut display, "possior.gif").unwrap();
    loop {
        std::thread::sleep(std::time::Duration::from_secs(1));
    }
    Ok(())
}

pub fn play_gif_file<D>(display: &mut D, file_path: &str) -> Result<(), Box<dyn std::error::Error>>
where
    D: DrawTarget<Color = Rgb565>,
    D::Error: std::fmt::Debug,
{
    use std::fs::File;
    use std::io::Write;
    use std::thread;
    use std::time::{Duration, Instant};

    use embedded_graphics::{pixelcolor::Rgb565, prelude::*, primitives::Rectangle};
    println!("Loading file: {}", file_path);
    let file = File::open(file_path)?;

    let mut options = DecodeOptions::new();
    options.set_color_output(gif::ColorOutput::RGBA);

    let mut decoder = options.read_info(file)?;

    let display_width = 240;
    let display_height = 240;

    // Buffer to track frame updates across transparent GIF layers
    let mut current_frame = vec![Rgb565::BLACK; display_width * display_height];
    let mut decoded_frames = Vec::new();

    println!("Decoding GIF frames into RAM...");

    let mut frame_count = 0;
    while let Some(frame) = decoder.read_next_frame()? {
        frame_count += 1;
        print!("\rDecoding frame {}...", frame_count);
        let _ = std::io::stdout().flush();

        let delay_ms = if frame.delay == 0 {
            100
        } else {
            u64::from(frame.delay) * 10
        };

        let frame_left = frame.left as usize;
        let frame_top = frame.top as usize;
        let frame_width = frame.width as usize;
        let frame_height = frame.height as usize;

        for (i, chunk) in frame.buffer.chunks_exact(4).enumerate() {
            let a = chunk[3];

            if a >= 128 {
                let r = chunk[0];
                let g = chunk[1];
                let b = chunk[2];

                // Scale 8-bit RGBA down to 5-6-5 bits
                let r5 = r >> 3;
                let g6 = g >> 2;
                let b5 = b >> 3;

                // Create clean Rgb565 without touching raw endianness/bits manually!
                // mipidsi will handle BGR and SPI byte ordering automatically.
                let pixel_color = Rgb565::new(r5, g6, b5);

                let x = frame_left + (i % frame_width);
                let y = frame_top + (i / frame_width);

                if x < display_width && y < display_height {
                    current_frame[y * display_width + x] = pixel_color;
                }
            }
        }

        decoded_frames.push((current_frame.clone(), delay_ms));
    }

    println!(
        "\nSuccessfully decoded {} frames! Starting playback...",
        decoded_frames.len()
    );

    loop {
        for (pixels, delay_ms) in &decoded_frames {
            let start = Instant::now();

            let area = Rectangle::new(
                Point::zero(),
                Size::new(display_width as u32, display_height as u32),
            );
            display
                .fill_contiguous(&area, pixels.iter().copied())
                .map_err(|e| format!("Frame write error: {:?}", e))?;

            let elapsed = start.elapsed();
            let target = Duration::from_millis(*delay_ms);
            if target > elapsed {
                thread::sleep(target - elapsed);
            }
        }
    }
}
